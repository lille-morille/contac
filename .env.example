# Local Supabase: run bun run supabase:start, then copy its printed keys here.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:57322/postgres
SUPABASE_URL=http://127.0.0.1:57321
SUPABASE_SECRET_KEY=REPLACE_WITH_LOCAL_SECRET_KEY
VITE_SUPABASE_URL=/sb-proxy
VITE_SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_LOCAL_PUBLISHABLE_KEY
VITE_API_URL=/api-proxy
APP_ORIGIN=http://localhost:3000
API_PORT=8787
API_HOST=127.0.0.1
CLASS_SETUP_CODE=REPLACE_WITH_A_LONG_RANDOM_SECRET
# Required to encrypt team OpenRouter tokens before enabling check-in AI.
AI_ENCRYPTION_KEY=replace-with-a-long-random-secret-before-enabling-checkin-ai
# Set for production agent execution. Worker records a clear failure if absent.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-6
# The API uses INBOUND_ADDRESS for the displayed Bcc address and
# INBOUND_WEBHOOK_SECRET to authenticate mail intake. The separate mail service
# also needs both values, plus the webhook URL and SMTP settings below.
# Leave INBOUND_ADDRESS empty until local SMTP testing or production cutover.
INBOUND_ADDRESS=
SMTP_PORT=2525
SMTP_HOST=127.0.0.1
INBOUND_WEBHOOK_SECRET=replace-with-a-long-random-secret
INBOUND_WEBHOOK_URL=http://127.0.0.1:8787/webhooks/inbound-email
MAIL_HEALTH_PORT=8788
