{
  "name": "contac",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.9",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run dev:stack",
    "dev:stack": "bun --filter '@contac/api' dev & bun --filter '@contac/agent' dev & bun --filter '@contac/app' dev & wait",
    "dev:api": "bun --filter '@contac/api' dev",
    "dev:app": "bun --filter '@contac/app' dev",
    "dev:worker": "bun --filter '@contac/agent' dev",
    "build": "bun --filter '*' build",
    "typecheck": "bun --filter '*' typecheck",
    "lint": "oxlint packages",
    "fmt": "oxfmt 'packages/**/*.{ts,tsx,css}'",
    "fmt:check": "oxfmt --check 'packages/**/*.{ts,tsx,css}'",
    "test": "vitest run",
    "db:migrate": "bun packages/core/src/db/migrate.ts",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "smoke:local": "bun --env-file=.env scripts/smoke-local.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.68.0",
    "supabase": "^2.104.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "@supabase/supabase-js": "^2.107.0"
  }
}
